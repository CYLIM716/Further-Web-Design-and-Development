doctype html
html
  head
    title Reset Password
    link(rel="stylesheet" href="/css/resetpsw.css")
  body
    img.background(src="background.jpeg" alt="background")
    .login-container
      .login-card
        .form-side
          h1 Reset Password!
          form(action="/forgotpassword" method="POST")
            input.input-field(type="text" name="username" placeholder="Username")
            input.input-field(type="password" name="password" placeholder="New Password")
            input.input-field(type="password" name="confirmpassword" placeholder="Confirm Password")
            button.reset-btn(type="submit") Reset Password
            if errorMessage
              p.error= errorMessage
        .image-side
          img(src="sideimage.jpg" alt="background")
        
